<details class="deep">
  <summary>Tiefer graben: die Rechnung hinter dem Rechner</summary>
  <div class="deep-body">
    <h3>Die Formeln</h3>
    <p>Ein Satellit auf einer Kreisbahn mit dem Radius r = R<sub>E</sub> + h fliegt mit dem Tempo</p>
    <span class="formula">v = √(GM / r)</span>
    <p>Spezielle Relativitätstheorie – die bewegte Uhr geht langsamer:</p>
    <span class="formula">Δt / t ≈ −v² / (2c²) = −GM / (2rc²)</span>
    <p>Allgemeine Relativitätstheorie – weiter oben im Schwerefeld geht die Uhr schneller:</p>
    <span class="formula">Δt / t ≈ (GM / c²) · (1/R<sub>E</sub> − 1/r)</span>
    <p>Zusammen ergibt das (GM/c²) · (1/R<sub>E</sub> − 3/(2r)). Dieser Ausdruck wird null für r = 1,5 · R<sub>E</sub>, also in 3&nbsp;186&nbsp;km Höhe. Für GPS mit r&nbsp;≈&nbsp;26&nbsp;570&nbsp;km folgt +5,29&nbsp;·&nbsp;10<sup>−10</sup> − 0,83&nbsp;·&nbsp;10<sup>−10</sup> = +4,46&nbsp;·&nbsp;10<sup>−10</sup>. Mal 86&nbsp;400 Sekunden ergibt das 38,5&nbsp;µs pro Tag.</p>
    <p>GPS bestimmt Entfernungen aus Laufzeiten: s = c · t. Ein Uhrenfehler von 38,5&nbsp;µs entspricht deshalb 38,5&nbsp;µs&nbsp;·&nbsp;299&nbsp;792&nbsp;km/s&nbsp;≈&nbsp;11,5&nbsp;km.</p>
    <p class="consts">Gerechnet mit GM&nbsp;=&nbsp;3,986&nbsp;·&nbsp;10<sup>14</sup>&nbsp;m³/s², R<sub>E</sub>&nbsp;=&nbsp;6&nbsp;371&nbsp;km und c&nbsp;=&nbsp;299&nbsp;792&nbsp;458&nbsp;m/s.</p>

    <h3>So rechnet echtes GPS die Relativität ein</h3>
    <ul>
      <li>Die Atomuhren werden schon vor dem Start verstimmt: Sie laufen mit 10,229&nbsp;999&nbsp;995&nbsp;43&nbsp;MHz statt 10,23&nbsp;MHz, also um 4,465&nbsp;·&nbsp;10<sup>−10</sup> langsamer. Im All gehen sie dann richtig.</li>
      <li>Weil die Bahnen leicht elliptisch sind, schwankt der Effekt zusätzlich um bis zu einige zehn Nanosekunden. Das rechnet jeder GPS-Empfänger selbst heraus.</li>
      <li>Bodenstationen überwachen die Satellitenuhren und senden laufend Korrekturwerte mit.</li>
    </ul>

    <h3>Was hier vereinfacht ist</h3>
    <ul>
      <li>Kreisbahnen und eine kugelförmige, nicht rotierende Erde. Mit Erdrotation und genauer Erdform ergeben sich 38,6 statt 38,5&nbsp;µs pro Tag.</li>
      <li>Der Kreis zeigt den Fehler einer einzelnen Entfernungsmessung. Weil alle GPS-Uhren fast gleich stark vorgehen würden, könnte ein Empfänger einen Teil davon herausrechnen. Die GPS-Zeit liefe aber der Zeit auf der Erde davon – und Mobilfunk, Stromnetze und Börsen, die ihre Uhren per GPS abgleichen, kämen aus dem Takt.</li>
    </ul>
  </div>
</details>
</main>

<footer>
  <p>Station 9 von 10 im Rundgang „Alles relativ?“. Läuft ohne Internet, auf Tablet, Laptop und Handy.</p>
</footer>
</div>

<script>
(function () {
  'use strict';
  // ---------- Physik ----------
  var GM = 3.986004418e14, RE = 6371e3, C = 299792458, DAY = 86400;
  var GPS_H = 20200;
  function rates(hKm) {
    var r = RE + hKm * 1e3;
    var srt = -GM / (2 * r * C * C) * DAY * 1e6;          // µs pro Tag
    var art = GM / (C * C) * (1 / RE - 1 / r) * DAY * 1e6; // µs pro Tag
    return { srt: srt, art: art, sum: srt + art, v: Math.sqrt(GM / r), T: 2 * Math.PI * Math.sqrt(r * r * r / GM) };
  }
  var CORR = rates(GPS_H).sum; // Korrektur ab Werk, im Modell genau passend für die GPS-Bahn

  // ---------- Zahlen auf Deutsch ----------
  var NNBSP = '\u00A0', MINUS = '\u2212';
  function group(intStr) { return intStr.length > 3 ? intStr.replace(/\B(?=(\d{3})+(?!\d))/g, NNBSP) : intStr; }
  function fmt(x, dec) {
    var s = Math.abs(x).toFixed(dec).split('.');
    var out = group(s[0]) + (dec > 0 ? ',' + s[1] : '');
    return (x < 0 && Number(Math.abs(x).toFixed(dec)) !== 0 ? MINUS : '') + out;
  }
  function fmtSigned(x, dec) {
    var s = fmt(x, dec);
    if (s.charAt(0) === MINUS) return s;
    return Number(Math.abs(x).toFixed(dec)) === 0 ? s : '+' + s;
  }
  function fmtTime(days) {
    var sec = days * DAY;
    if (sec < 0.5) return '0\u00A0Sekunden';
    if (sec < 59.5) { var s = Math.round(sec); return s + (s === 1 ? '\u00A0Sekunde' : '\u00A0Sekunden'); }
    var totalMin = Math.round(sec / 60);
    if (totalMin < 60) return totalMin + (totalMin === 1 ? '\u00A0Minute' : '\u00A0Minuten');
    if (totalMin < 24 * 60) {
      var h = Math.floor(totalMin / 60), m = totalMin % 60;
      return h + '\u00A0h' + (m ? ' ' + m + '\u00A0min' : '');
    }
    var totalH = Math.round(sec / 3600), d = Math.floor(totalH / 24), hh = totalH % 24;
    return d + (d === 1 ? '\u00A0Tag' : '\u00A0Tage') + (hh ? ' ' + hh + '\u00A0h' : '');
  }
  function fmtClock(us) {
    var a = Math.abs(us);
    if (a < 1) return fmt(a * 1000, 0) + '\u00A0ns';
    if (a < 1000) return fmt(a, 1) + '\u00A0µs';
    return fmt(a / 1000, 2) + '\u00A0ms';
  }
  function fmtDist(km) {
    if (km < 1) return fmt(km * 1000, 0) + '\u00A0m';
    if (km < 100) return fmt(km, 1) + '\u00A0km';
    return fmt(km, 0) + '\u00A0km';
  }
  function fmtKmPlain(km) { return km < 1 ? fmt(Math.round(km * 100) * 10, 0) + '\u00A0m' : (km < 10 ? fmt(km, 1) + '\u00A0km' : fmt(km, 0) + '\u00A0km'); }
  function fmtPeriod(sec) {
    var totalMin = Math.round(sec / 60);
    if (totalMin < 60) return totalMin + '\u00A0min';
    var h = Math.floor(totalMin / 60), m = totalMin % 60;
    return h + '\u00A0h ' + m + '\u00A0min';
  }

  // ---------- Orte (Entfernung und Richtung ab Hannover-Mitte, Kröpcke) ----------
  var LAT0 = 52.3745, LON0 = 9.7386;
  var RAW = [
    ['Hauptbahnhof', 'bis zum Hauptbahnhof', 52.3766, 9.7410, 2],
    ['Neues Rathaus', 'bis zum Neuen Rathaus', 52.3681, 9.7383, 2],
    ['Maschsee', 'bis zum Maschsee', 52.3555, 9.7435, 2],
    ['Herrenhäuser Gärten', 'bis zu den Herrenhäuser Gärten', 52.3893, 9.6977, 2],
    ['Messe', 'bis zur Messe', 52.3216, 9.8130, 2],
    ['Flughafen', 'bis zum Flughafen', 52.4611, 9.6850, 2],
    ['GEO600', 'bis zum Gravitationswellen-Detektor GEO600', 52.2466, 9.8081, 2],
    ['Steinhuder Meer', 'bis zum Steinhuder Meer', 52.4740, 9.3300, 2],
    ['Hildesheim', 'bis Hildesheim', 52.1508, 9.9511, 2],
    ['Peine', 'bis Peine', 52.3203, 10.2336, 3],
    ['Celle', 'bis Celle', 52.6226, 10.0805, 2],
    ['Hameln', 'bis Hameln', 52.1031, 9.3600, 3],
    ['Nienburg', 'bis Nienburg', 52.6461, 9.2085, 3],
    ['Braunschweig', 'bis Braunschweig', 52.2689, 10.5268, 2],
    ['Wolfsburg', 'bis Wolfsburg', 52.4227, 10.7865, 2],
    ['Bielefeld', 'bis Bielefeld', 52.0302, 8.5325, 2],
    ['Göttingen', 'bis Göttingen', 51.5413, 9.9158, 2],
    ['Bremen', 'bis Bremen', 53.0793, 8.8017, 1],
    ['Osnabrück', 'bis Osnabrück', 52.2799, 8.0472, 2],
    ['Kassel', 'bis Kassel', 51.3127, 9.4797, 2],
    ['Hamburg', 'bis Hamburg', 53.5511, 9.9937, 1],
    ['Magdeburg', 'bis Magdeburg', 52.1205, 11.6276, 2],
    ['Münster', 'bis Münster', 51.9607, 7.6261, 2],
    ['Dortmund', 'bis Dortmund', 51.5136, 7.4653, 1],
    ['Leipzig', 'bis Leipzig', 51.3397, 12.3731, 1],
    ['Kiel', 'bis Kiel', 54.3233, 10.1228, 2],
    ['Köln', 'bis Köln', 50.9375, 6.9603, 1],
    ['Rostock', 'bis Rostock', 54.0924, 12.0991, 2],
    ['Berlin', 'bis Berlin', 52.5200, 13.4050, 1],
    ['Frankfurt', 'bis Frankfurt am Main', 50.1109, 8.6821, 1],
    ['Dresden', 'bis Dresden', 51.0504, 13.7373, 1],
    ['Amsterdam', 'bis Amsterdam', 52.3676, 4.9041, 1],
    ['Stuttgart', 'bis Stuttgart', 48.7758, 9.1829, 1],
    ['Brüssel', 'bis Brüssel', 50.8503, 4.3517, 1],
    ['Prag', 'bis Prag', 50.0755, 14.4378, 1],
    ['Kopenhagen', 'bis Kopenhagen', 55.6761, 12.5683, 1],
    ['München', 'bis München', 48.1351, 11.5820, 1]
  ];
  var rad = Math.PI / 180;
  function geo(lat, lon) {
    var p1 = LAT0 * rad, p2 = lat * rad, dl = (lon - LON0) * rad;
    var h = Math.pow(Math.sin((p2 - p1) / 2), 2) + Math.cos(p1) * Math.cos(p2) * Math.pow(Math.sin(dl / 2), 2);
    var d = 2 * 6371 * Math.asin(Math.sqrt(h));
    var b = Math.atan2(Math.sin(dl) * Math.cos(p2), Math.cos(p1) * Math.sin(p2) - Math.sin(p1) * Math.cos(p2) * Math.cos(dl));
    return { d: d, b: b };
  }
  var PLACES = RAW.map(function (p) {
    var g = geo(p[2], p[3]);
    return { name: p[0], to: p[1], d: g.d, b: g.b, prio: p[4] };
  }).sort(function (a, b) { return a.d - b.d; });

  // ---------- Zustand ----------
  var DEFAULT = { s: 0, h: GPS_H, corr: false };
  var state = { s: 0, h: GPS_H, corr: false, playing: false };
  var $ = function (id) { return document.getElementById(id); };
  var SVGNS = 'http://www.w3.org/2000/svg';
  function sToDays(s) { return 30 * Math.pow(s / 1000, 3); }
  function daysToS(d) { return 1000 * Math.cbrt(Math.min(d, 30) / 30); }
  function altToH(a) { return 200 + 39800 * Math.pow(a / 1000, 2); }
  function hToAlt(h) { return 1000 * Math.sqrt(Math.max(0, h - 200) / 39800); }
  function drift() { var d = rates(state.h).sum - (state.corr ? CORR : 0); return Math.abs(d) < 1e-9 ? 0 : d; }

  // ---------- Karte ----------
  var placeLayer = $('places'), ringLayer = $('rings');
  PLACES.forEach(function (p) {
    var g = document.createElementNS(SVGNS, 'g');
    var dot = document.createElementNS(SVGNS, 'circle');
    dot.setAttribute('r', p.prio === 1 ? 4.5 : 3.5);
    var t = document.createElementNS(SVGNS, 'text');
    t.setAttribute('font-family', 'Carlito, Calibri, sans-serif');
    t.setAttribute('font-size', p.prio === 1 ? 17 : 15);
    t.textContent = p.name;
    g.appendChild(dot); g.appendChild(t);
    placeLayer.appendChild(g);
    p.g = g; p.dot = dot; p.text = t;
    p.w = p.name.length * (p.prio === 1 ? 8.2 : 7.3);
  });
  var RING_STEPS = [0.05, 0.1, 0.2, 0.5, 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000];
  var ringNodes = [];
  for (var i = 0; i < 3; i++) {
    var c = document.createElementNS(SVGNS, 'circle');
    c.setAttribute('cx', 320); c.setAttribute('cy', 320); c.setAttribute('fill', 'none');
    c.setAttribute('stroke', '#DCE6F2'); c.setAttribute('stroke-opacity', '0.16'); c.setAttribute('stroke-dasharray', '3 6');
    var tl = document.createElementNS(SVGNS, 'text');
    tl.setAttribute('font-family', 'Carlito, Calibri, sans-serif'); tl.setAttribute('font-size', '14');
    tl.setAttribute('fill', '#DCE6F2'); tl.setAttribute('fill-opacity', '0.5');
    ringLayer.appendChild(c); ringLayer.appendChild(tl);
    ringNodes.push({ c: c, t: tl });
  }
  function ringLabel(km) { return km < 1 ? fmt(km * 1000, 0) + '\u00A0m' : fmt(km, 0) + '\u00A0km'; }

  var mapSvg = $('map'), centerLabel = document.querySelector('#center text');
  function drawMap(errKm) {
    var rect = mapSvg.getBoundingClientRect();
    var size = Math.min(rect.width, rect.height) || 640;
    var k = Math.min(1.75, Math.max(1, 0.9 * 640 / size));
    var viewR = Math.max(errKm * 1.35, 0.36);
    var scale = 280 / viewR;
    var rpx = errKm * scale;
    $('err-fill').setAttribute('r', rpx.toFixed(2));
    $('err-glow').setAttribute('r', rpx.toFixed(2));
    $('err').style.display = errKm > 0 ? '' : 'none';
    var cfs = 15 * k;
    centerLabel.setAttribute('font-size', cfs.toFixed(1));
    centerLabel.setAttribute('y', (320 + 14 + cfs).toFixed(1));
    var cw = 112 * k;
    var boxes = [{ x0: 320 - cw / 2 - 4, x1: 320 + cw / 2 + 4, y0: 330, y1: 320 + 18 + cfs }, { x0: 304, x1: 336, y0: 304, y1: 336 }];
    function free(b) {
      for (var j = 0; j < boxes.length; j++) {
        var o = boxes[j];
        if (b.x0 < o.x1 && b.x1 > o.x0 && b.y0 < o.y1 && b.y1 > o.y0) return false;
      }
      return true;
    }
    // Ringe (Beschriftung oben rechts, Platz wird reserviert)
    var rings = RING_STEPS.filter(function (r) { return r <= viewR * 1.08 && r >= viewR * 0.1; }).slice(-3);
    ringNodes.forEach(function (n, idx) {
      var r = rings[idx];
      if (r === undefined) { n.c.style.display = 'none'; n.t.style.display = 'none'; return; }
      var pr = r * scale;
      n.c.style.display = '';
      n.c.setAttribute('r', pr.toFixed(2));
      var fs = 14 * k, txt = ringLabel(r), w = txt.length * 7 * k;
      var tx = 320 + pr * 0.7071 + 4, ty = 320 - pr * 0.7071 - 4;
      var b = { x0: tx, x1: tx + w, y0: ty - fs, y1: ty + 2 };
      if (pr > 40 && b.x1 < 636 && b.y0 > 4 && free(b)) {
        boxes.push(b);
        n.t.style.display = '';
        n.t.setAttribute('font-size', fs.toFixed(1));
        n.t.setAttribute('x', tx.toFixed(1)); n.t.setAttribute('y', ty.toFixed(1));
        n.t.textContent = txt;
      } else {
        n.t.style.display = 'none';
      }
    });
    // Punkte zuerst, damit Beschriftungen keine anderen Punkte verdecken
    var visibleList = [];
    PLACES.forEach(function (p) {
      var x = 320 + p.d * Math.sin(p.b) * scale, y = 320 - p.d * Math.cos(p.b) * scale;
      var inCenter = x > boxes[0].x0 - 4 && x < boxes[0].x1 + 4 && y > 304 && y < boxes[0].y1 + 4;
      var visible = x > 8 && x < 632 && y > 8 && y < 632 && p.d * scale > 16 && !inCenter;
      if (!visible) { p.g.style.display = 'none'; return; }
      p.g.style.display = '';
      p.x = x; p.y = y; p.inside = p.d <= errKm;
      p.dot.setAttribute('cx', x.toFixed(1)); p.dot.setAttribute('cy', y.toFixed(1));
      p.dot.setAttribute('r', ((p.prio === 1 ? 4.5 : 3.5) * Math.sqrt(k)).toFixed(1));
      p.dot.setAttribute('fill', p.inside ? '#F2A65A' : '#A9BDD6');
      visibleList.push(p);
    });
    visibleList.forEach(function (p) { boxes.push({ x0: p.x - 4, x1: p.x + 4, y0: p.y - 4, y1: p.y + 4, own: p }); });
    function freeFor(b, p) {
      for (var j = 0; j < boxes.length; j++) {
        var o = boxes[j];
        if (o.own === p) continue;
        if (b.x0 < o.x1 && b.x1 > o.x0 && b.y0 < o.y1 && b.y1 > o.y0) return false;
      }
      return true;
    }
    visibleList.sort(function (a, b) { return a.prio - b.prio || a.d - b.d; });
    visibleList.forEach(function (p) {
      var x = p.x, y = p.y, fs = (p.prio === 1 ? 17 : 15) * k, w = p.w * k, g = 7 * Math.sqrt(k);
      var cand = [
        { x0: x + g, x1: x + g + w, y0: y - fs * 0.62, y1: y + fs * 0.42, tx: x + g, ty: y + fs * 0.32, a: 'start' },
        { x0: x - g - w, x1: x - g, y0: y - fs * 0.62, y1: y + fs * 0.42, tx: x - g, ty: y + fs * 0.32, a: 'end' },
        { x0: x - w / 2, x1: x + w / 2, y0: y - 6 - fs, y1: y - 6, tx: x, ty: y - 8, a: 'middle' },
        { x0: x - w / 2, x1: x + w / 2, y0: y + 6, y1: y + 8 + fs, tx: x, ty: y + 4 + fs, a: 'middle' }
      ];
      var pick = null;
      if (p.prio < 3 || p.d * scale > 60) {
        for (var c = 0; c < cand.length; c++) {
          var b = cand[c];
          if (b.x0 >= 4 && b.x1 <= 636 && b.y0 >= 4 && b.y1 <= 636 && freeFor(b, p)) { pick = b; break; }
        }
      }
      if (pick) {
        boxes.push(pick);
        p.text.style.display = '';
        p.text.setAttribute('font-size', fs.toFixed(1));
        p.text.setAttribute('x', pick.tx.toFixed(1)); p.text.setAttribute('y', pick.ty.toFixed(1));
        p.text.setAttribute('text-anchor', pick.a);
        p.text.setAttribute('fill', p.inside ? '#FFD9B5' : '#DCE6F2');
        p.text.setAttribute('fill-opacity', p.inside ? '1' : '0.82');
      } else {
        p.text.style.display = 'none';
      }
    });
  }

  // ---------- Vergleiche ----------
  function compareText(errKm, days) {
    if (errKm === 0) {
      if (state.corr) return 'Mit eingerechneter Relativitätstheorie entsteht kein Fehler – genau so arbeitet echtes GPS.';
      if (days === 0) return 'Die Uhren wurden gerade gestellt. Starte den Zeitraffer und sieh zu, wie schnell der Fehler wächst.';
      return 'In dieser Höhe heben sich beide Effekte auf – es entsteht kein Fehler.';
    }
    var m = errKm * 1000;
    if (m < 100) {
      var sec = Math.max(1, Math.round(m / 1.4));
      return 'So weit gehst du zu Fuß in ' + (sec === 1 ? 'einer Sekunde' : 'etwa ' + sec + '\u00A0Sekunden') + '.';
    }
    var nearest = null;
    for (var i = 0; i < PLACES.length; i++) if (PLACES[i].d <= errKm) nearest = PLACES[i];
    if (!nearest) {
      var n = m / 105;
      return 'Das sind schon ' + fmt(n, 1) + ' Fußballfelder hintereinander.';
    }
    return 'Weiter als von Hannover-Mitte ' + nearest.to + ' (' + fmtKmPlain(nearest.d) + ' Luftlinie).';
  }

  function assumeHtml() {
    var isGps = Math.abs(state.h - GPS_H) < 1;
    var txt = isGps ? 'Gerechnet für die GPS-Bahn in 20' + NNBSP + '200 km Höhe'
                    : 'Gerechnet für eine Bahn in ' + fmt(state.h, 0) + '\u00A0km Höhe statt der GPS-Bahn';
    txt += state.corr ? ', mit der Korrektur ab Werk.' : ', ohne Korrektur.';
    if (state.corr && !isGps) txt += ' Diese Korrektur passt nur zur GPS-Bahn – deshalb bleibt ein Rest.';
    if (!isGps) txt += ' <button type="button" id="back-gps">Zurück zur GPS-Bahn</button>';
    return txt;
  }

  // ---------- Diagramm ----------
  var CH = { w: 720, h: 400, l: 64, r: 18, t: 18, b: 52, hMax: 40000, yMin: -40, yMax: 60, k: 1 };
  function cx(h) { return CH.l + (h / CH.hMax) * (CH.w - CH.l - CH.r); }
  function cy(v) { return CH.t + (CH.yMax - v) / (CH.yMax - CH.yMin) * (CH.h - CH.t - CH.b); }
  var chart = $('chart');
  function el(name, attrs, parent) {
    var e = document.createElementNS(SVGNS, name);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    (parent || chart).appendChild(e);
    return e;
  }
  var css = getComputedStyle(document.documentElement);
  function col(v) { return css.getPropertyValue(v).trim(); }
  function buildChart() {
    while (chart.firstChild) chart.removeChild(chart.firstChild);
    css = getComputedStyle(document.documentElement);
    var w = chart.getBoundingClientRect().width || 720;
    var k = Math.min(2, Math.max(1, 0.9 * 720 / w));
    CH.k = k; CH.l = 26 + 30 * k; CH.b = 26 + 26 * k; CH.t = 10 + 8 * k;
    var fs = 15 * k;
    var muted = col('--muted'), rule = col('--rule');
    var font = 'Carlito, sans-serif';
    for (var v = -40; v <= 60; v += 20) {
      el('line', { x1: CH.l, x2: CH.w - CH.r, y1: cy(v), y2: cy(v), stroke: v === 0 ? muted : rule, 'stroke-width': v === 0 ? 1.5 : 1 });
      var lab = el('text', { x: CH.l - 8, y: cy(v) + fs * 0.34, 'text-anchor': 'end', 'font-size': fs, fill: muted, 'font-family': font });
      lab.textContent = v === 0 ? '0' : fmtSigned(v, 0);
    }
    var step = k > 1.4 ? 20000 : 10000;
    for (var h = 0; h <= 40000; h += step) {
      var tx = el('text', { x: cx(h), y: CH.h - CH.b + fs + 6, 'text-anchor': h === 0 ? 'start' : (h === 40000 ? 'end' : 'middle'), 'font-size': fs, fill: muted, 'font-family': font });
      tx.textContent = h === 0 ? '0' : fmt(h, 0);
    }
    var xl = el('text', { x: (CH.l + CH.w - CH.r) / 2, y: CH.h - 6, 'text-anchor': 'middle', 'font-size': fs, fill: muted, 'font-family': font });
    xl.textContent = 'Bahnhöhe in km';
    var yl = el('text', { x: CH.l + 8, y: CH.t + fs, 'font-size': fs, fill: muted, 'font-family': font });
    yl.textContent = 'µs pro Tag';
    function path(fn) {
      var d = '';
      for (var i = 0; i <= 240; i++) {
        var hh = 40000 * i / 240;
        d += (i ? 'L' : 'M') + cx(hh).toFixed(1) + ' ' + cy(fn(rates(hh))).toFixed(1);
      }
      return d;
    }
    el('path', { d: path(function (r) { return r.srt; }), fill: 'none', stroke: col('--srt'), 'stroke-width': 2.5 });
    el('path', { d: path(function (r) { return r.art; }), fill: 'none', stroke: col('--art'), 'stroke-width': 2.5 });
    el('path', { d: path(function (r) { return r.sum; }), fill: 'none', stroke: col('--sum'), 'stroke-width': 3.5 });
    // Gleichstand: Punkt auf der Nulllinie, Beschriftung darunter
    var x0 = cx(RE / 2000);
    el('circle', { cx: x0, cy: cy(0), r: 4, fill: 'none', stroke: muted, 'stroke-width': 1.5 });
    var gl = el('text', { x: x0 + 8, y: cy(0) + fs + 4, 'font-size': fs, fill: muted, 'font-family': font });
    gl.textContent = k > 1.4 ? 'Gleichstand' : 'Gleichstand bei 3' + NNBSP + '186\u00A0km';
    chart.marker = el('line', { y1: CH.t, y2: CH.h - CH.b, stroke: col('--accent'), 'stroke-width': 2 });
    chart.dots = ['--srt', '--art', '--sum'].map(function (v) {
      return el('circle', { r: 6 * Math.sqrt(k), fill: col(v), stroke: col('--surface'), 'stroke-width': 2.5 });
    });
  }
  function drawChartMarker() {
    var r = rates(state.h), x = cx(state.h);
    chart.marker.setAttribute('x1', x); chart.marker.setAttribute('x2', x);
    [r.srt, r.art, r.sum].forEach(function (v, i) { chart.dots[i].setAttribute('cx', x); chart.dots[i].setAttribute('cy', cy(v)); });
  }

  // ---------- Darstellung ----------
  function setBar(id, v) {
    var f = $(id), max = 55, w = Math.min(Math.abs(v) / max, 1) * 50;
    f.style.width = w + '%';
    f.style.left = v >= 0 ? '50%' : (50 - w) + '%';
  }
  var lastAssume = '';
  function render() {
    var days = sToDays(state.s);
    var d = drift();
    var us = d * days;
    var errKm = Math.abs(us) * 1e-6 * C / 1000;
    if (days === 0) errKm = 0;
    $('r-time').textContent = fmtTime(days);
    $('r-clock-label').textContent = us > 0.0005 ? 'Satellitenuhr geht vor um' : (us < -0.0005 ? 'Satellitenuhr geht nach um' : 'Abweichung der Satellitenuhr');
    $('r-clock').textContent = fmtClock(us);
    $('r-dist').textContent = fmtDist(errKm);
    var cmp = compareText(errKm, days);
    $('compare').textContent = cmp;
    $('map').setAttribute('aria-label', 'Karte rund um Hannover. Fehler ' + fmtDist(errKm) + '. ' + cmp);
    var ah = assumeHtml();
    if (ah !== lastAssume) {
      lastAssume = ah;
      $('assume').innerHTML = ah;
      var back = $('back-gps');
      if (back) back.addEventListener('click', function () { setAlt(GPS_H); });
    }
    drawMap(errKm);
    var t = $('time');
    t.value = Math.round(state.s);
    t.style.setProperty('--p', (state.s / 10) + '%');
    t.setAttribute('aria-valuetext', fmtTime(days));
    document.querySelectorAll('.hero .chip').forEach(function (b) {
      b.setAttribute('aria-pressed', Math.abs(daysToS(+b.dataset.days) - state.s) < 0.6 ? 'true' : 'false');
    });
    $('corr').checked = state.corr;
  }
  function renderAlt() {
    var r = rates(state.h);
    $('e-v').textContent = fmt(r.v / 1000, 2) + '\u00A0km/s';
    $('e-h').textContent = fmt(state.h, 0) + '\u00A0km';
    $('e-srt').textContent = fmtSigned(r.srt, 1) + '\u00A0µs';
    $('e-art').textContent = fmtSigned(r.art, 1) + '\u00A0µs';
    $('e-sum').textContent = fmtSigned(r.sum, 1) + '\u00A0µs';
    $('e-sum-text').textContent = Math.abs(r.sum) < 0.05 ? 'Zusammen heben sich beide Effekte auf.'
      : (r.sum > 0 ? 'Zusammen geht die Satellitenuhr jeden Tag vor.' : 'Zusammen geht die Satellitenuhr jeden Tag nach.');
    setBar('b-srt', r.srt); setBar('b-art', r.art); setBar('b-sum', r.sum);
    $('a-h').textContent = fmt(state.h, 0) + '\u00A0km';
    $('a-v').textContent = fmt(r.v / 1000, 2) + '\u00A0km/s';
    $('a-T').textContent = fmtPeriod(r.T);
    $('a-sum').textContent = fmtSigned(r.sum, 1) + '\u00A0µs pro Tag';
    var cross = RE / 2000;
    $('verdict').textContent = Math.abs(state.h - cross) < 60
      ? 'Hier heben sich beide Effekte fast genau auf: Eine Uhr in dieser Bahn ginge so schnell wie am Boden.'
      : (state.h < cross
        ? 'In dieser Höhe überwiegt das Tempo: Die Uhr geht nach – so wie auf der Raumstation ISS.'
        : 'Hier überwiegt die schwächere Schwerkraft: Die Uhr geht vor – so wie bei GPS.');
    var a = $('alt');
    a.value = Math.round(hToAlt(state.h));
    a.style.setProperty('--p', (hToAlt(state.h) / 10) + '%');
    a.setAttribute('aria-valuetext', fmt(state.h, 0) + '\u00A0km');
    document.querySelectorAll('#orbit-chips .chip').forEach(function (b) {
      b.setAttribute('aria-pressed', Math.abs(+b.dataset.h - state.h) < 1 ? 'true' : 'false');
    });
    drawChartMarker();
  }
  function setAlt(h) { state.h = Math.max(200, Math.min(40000, h)); renderAlt(); render(); }

  // ---------- Zeitraffer ----------
  var last = null, raf = null;
  function setPlaying(on) {
    state.playing = on;
    $('compare').setAttribute('aria-live', on ? 'off' : 'polite');
    $('play-text').textContent = on ? 'Anhalten' : (state.s >= 1000 ? 'Noch einmal' : 'Zeit laufen lassen');
    $('play-icon').innerHTML = on ? '<path d="M5 3h3.5v14H5zM11.5 3H15v14h-3.5z"/>' : '<path d="M5 3 L17 10 L5 17 Z"/>';
    if (on) { last = null; raf = requestAnimationFrame(tick); } else if (raf) { cancelAnimationFrame(raf); raf = null; }
  }
  function tick(ts) {
    if (!state.playing) return;
    if (last === null) last = ts;
    var dt = Math.min(0.1, (ts - last) / 1000); last = ts;
    state.s = Math.min(1000, state.s + dt * 1000 / 10);
    render();
    if (state.s >= 1000) { setPlaying(false); return; }
    raf = requestAnimationFrame(tick);
  }
  $('play').addEventListener('click', function () {
    if (state.playing) { setPlaying(false); return; }
    if (state.s >= 1000) state.s = 0;
    setPlaying(true);
  });
  $('time').addEventListener('input', function (e) { setPlaying(false); state.s = +e.target.value; render(); });
  document.querySelectorAll('.hero .chip').forEach(function (b) {
    b.addEventListener('click', function () { setPlaying(false); state.s = daysToS(+b.dataset.days); render(); });
  });
  $('corr').addEventListener('change', function (e) { state.corr = e.target.checked; render(); });
  document.querySelectorAll('#orbit-chips .chip').forEach(function (b) {
    b.addEventListener('click', function () { setAlt(+b.dataset.h); });
  });
  $('alt').addEventListener('input', function (e) { setAlt(altToH(+e.target.value)); });
  function chartPick(ev) {
    var rect = chart.getBoundingClientRect();
    var x = (ev.clientX - rect.left) / rect.width * CH.w;
    var h = (x - CH.l) / (CH.w - CH.l - CH.r) * CH.hMax;
    setAlt(Math.round(h / 10) * 10);
  }
  var dragging = false;
  chart.addEventListener('pointerdown', function (ev) { dragging = true; chart.setPointerCapture(ev.pointerId); chartPick(ev); });
  chart.addEventListener('pointermove', function (ev) { if (dragging) chartPick(ev); });
  chart.addEventListener('pointerup', function () { dragging = false; });
  chart.addEventListener('pointercancel', function () { dragging = false; });

  // ---------- Vollbild (für das Ausstellungs-Tablet) ----------
  var fsBtn = $('fs'), docEl = document.documentElement;
  var canFs = document.fullscreenEnabled || document.webkitFullscreenEnabled;
  if (canFs) {
    fsBtn.hidden = false;
    fsBtn.addEventListener('click', function () {
      var inFs = document.fullscreenElement || document.webkitFullscreenElement;
      if (inFs) (document.exitFullscreen || document.webkitExitFullscreen).call(document);
      else (docEl.requestFullscreen || docEl.webkitRequestFullscreen).call(docEl);
    });
    ['fullscreenchange', 'webkitfullscreenchange'].forEach(function (n) {
      document.addEventListener(n, function () {
        fsBtn.textContent = (document.fullscreenElement || document.webkitFullscreenElement) ? 'Vollbild beenden' : 'Vollbild';
      });
    });
  }

  // ---------- Nach 2 Minuten ohne Bedienung zurücksetzen ----------
  var lastTouch = Date.now();
  ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(function (n) {
    window.addEventListener(n, function () { lastTouch = Date.now(); }, { passive: true });
  });
  setInterval(function () {
    var idle = Date.now() - lastTouch > 120000;
    var isDefault = state.s === DEFAULT.s && state.h === DEFAULT.h && state.corr === DEFAULT.corr && !state.playing;
    if (idle && !isDefault && !state.playing) {
      state.s = DEFAULT.s; state.h = DEFAULT.h; state.corr = DEFAULT.corr;
      document.querySelectorAll('details').forEach(function (d) { d.open = false; });
      setPlaying(false); renderAlt(); render();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }, 5000);

  // Farbschema-Wechsel: Diagramm neu zeichnen
  if (window.matchMedia) {
    var mq = window.matchMedia('(prefers-color-scheme: dark)');
    var onScheme = function () { buildChart(); renderAlt(); };
    if (mq.addEventListener) mq.addEventListener('change', onScheme); else if (mq.addListener) mq.addListener(onScheme);
  }

  var rsz = null;
  window.addEventListener('resize', function () {
    clearTimeout(rsz);
    rsz = setTimeout(function () { buildChart(); renderAlt(); render(); }, 150);
  });

  buildChart();
  renderAlt();
  render();
})();
</script>
</body>
</html>
